# Copy to .env and fill with freshly rotated credentials
BOT_TOKEN=PASTE_NEW_DISCORD_BOT_TOKEN_HERE
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
MONGODB_URI=YOUR_MONGODB_ATLAS_URI
MONGODB_DB_NAME=multipurpose_discord_bot
# Optional: leave blank for global commands; set test server ID for fast guild registration
GUILD_ID=
BOT_PREFIX=!
OWNER_IDS=YOUR_DISCORD_USER_ID
PORT=3000
NODE_ENV=development
